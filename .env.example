# Supabase 프로젝트 설정 > API 에서 복사합니다.
# EXPO_PUBLIC_ 접두사가 붙은 값은 앱 번들에 그대로 포함되므로
# service_role key 는 절대 여기에 넣지 마세요. (RLS 로 보호되는 anon key 만)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# [선택] 예전에 태블릿의 단지를 정하던 값입니다. 이제 태블릿은 최초 설정 때
# 단지 등록 코드를 입력해 자기 단지를 기억하므로, 새로 설치하는 기기에는
# 필요 없습니다. 이 값이 박힌 채로 이미 설치된 태블릿을 새 형식으로 옮길 때만
# 한 번 읽힙니다.
EXPO_PUBLIC_FITROUTINE_APT_ID=11111111-1111-4111-8111-111111111111
