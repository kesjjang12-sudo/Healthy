# Supabase 프로젝트 설정 > API 에서 복사합니다.
# EXPO_PUBLIC_ 접두사가 붙은 값은 앱 번들에 그대로 포함되므로
# service_role key 는 절대 여기에 넣지 마세요. (RLS 로 보호되는 anon key 만)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 이 태블릿이 설치된 아파트 단지 id (apartments.id)
# supabase/seed.sql 을 그대로 넣었다면 아래 값을 쓰면 됩니다.
EXPO_PUBLIC_FITROUTINE_APT_ID=11111111-1111-4111-8111-111111111111
