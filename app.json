{
  "expo": {
    "name": "핏루틴",
    "slug": "fitroutine",
    "version": "0.1.0",
    "scheme": "fitroutine",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/a4d7f146-ab6e-4dac-8873-c2bdcd43563d"
    },
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.fitroutine.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B5FD1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fitroutine.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B5FD1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "기구 QR과 페어링 QR을 스캔하려면 카메라 권한이 필요합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/Healthy"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a4d7f146-ab6e-4dac-8873-c2bdcd43563d"
      }
    },
    "owner": "kesjjang4545"
  }
}
